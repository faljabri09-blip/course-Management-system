  "components": {
    "schemas": {
      "Course": {
        "required": [
          "courseName",
          "instructorId",
          "price"
        ],
        "type": "object",
        "properties": {
          "courseId": {
            "type": "integer",
            "format": "int32"
          },
          "courseName": {
            "maxLength": 100,
            "minLength": 0,
            "type": "string"
          },
          "description": {
            "maxLength": 100,
            "type": "string",
            "nullable": true
          },
          "duration": {
            "maximum": 500,
            "minimum": 1,
            "maxLength": 50,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "maximum": 10000,
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "instructorId": {
            "type": "integer",
            "format": "int32"
          },
