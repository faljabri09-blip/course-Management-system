            "type": "integer",
            "format": "int32"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "nullable": true
          },
          "credits": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "price": {
            "minimum": 0,
            "type": "number",
            "format": "double"
          },
          "instructorId": {
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
